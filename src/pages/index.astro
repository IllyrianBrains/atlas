</style>

<script>
  declare global { interface Window { L: any } }
  const mapElement = document.querySelector<HTMLElement>('#country-map');
  if (mapElement && window.L) {
    const L = window.L;
    type MapCity = {slug:string;title:string;center:[number,number]};
    type MapCountry = {slug:string;title:string;flag:string;iso:string;geoName?:string;fallbackCenter?:[number,number];cities:MapCity[]};
    const countries: MapCountry[] = JSON.parse(mapElement.dataset.countries || '[]');
    const map = L.map(mapElement, { scrollWheelZoom: true, touchZoom: true, zoomControl: true, minZoom: 2 }).setView([43, 2], 3);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' }).addTo(map);
    const byIso = new Map(countries.map((country) => [country.iso, country]));
    const byName = new Map(countries.filter((country) => country.geoName).map((country) => [country.geoName, country]));
    fetch(mapElement.dataset.boundaries || '').then((response) => response.json()).then((world) => {
      const countryFor = (feature:any):MapCountry|undefined => byIso.get(feature.properties.iso_a3) || byName.get(feature.properties.name);
      const selected = { ...world, features: world.features.filter((feature:any) => countryFor(feature)) };
      const rendered = new Set<string>();
      const shapes = L.geoJSON(selected, {
        style: { className: 'atlas-country-shape', color: '#c9aebd', weight: 1.3, opacity: .9, fillColor: '#744761', fillOpacity: .42 },
        onEachFeature: (feature:any, layer:any) => {
          const country = countryFor(feature)!; rendered.add(country.slug);
          const cityLabel = country.cities.length === 1 ? '1 qytet i rrjetit' : country.cities.length > 1 ? `${country.cities.length} qytete të rrjetit` : 'Guidë shteti';
          layer.bindTooltip(`${country.flag} ${country.title}`, { sticky: true });
          const countryAction = country.status === 'published' ? `<a href="/${country.slug}/">Hap shtetin <b>→</b></a>` : '<em>Guidë në përgatitje</em>';
          layer.bindPopup(`<div class="map-popup"><small>${country.flag} Shtet</small><strong>${country.title}</strong><span>${cityLabel}</span>${countryAction}</div>`);
          layer.on('click', () => map.flyToBounds(layer.getBounds(), { padding: [55, 55], maxZoom: 7, duration: .65 }));
        },
      }).addTo(map);
      countries.filter((country) => !rendered.has(country.slug) && country.fallbackCenter).forEach((country) => {
        const marker = L.circleMarker(country.fallbackCenter!, { radius: 9, color: '#c9aebd', weight: 2, fillColor: '#744761', fillOpacity: .72 });
        const countryAction = country.status === 'published' ? `<a href="/${country.slug}/">Hap shtetin <b>→</b></a>` : '<em>Guidë në përgatitje</em>';
        marker.bindPopup(`<div class="map-popup"><small>${country.flag} Shtet</small><strong>${country.title}</strong><span>Guidë shteti</span>${countryAction}</div>`).addTo(map);
      });
      countries.flatMap((country) => country.cities.map((city) => ({ ...city, country }))).forEach(({ country, ...city }) => {
        const marker = L.circleMarker(city.center, { radius: 5.5, color: '#fff', weight: 2, fillColor: '#d8a74b', fillOpacity: 1 });
        marker.bindTooltip(city.title, { direction: 'top', offset: [0, -6] });
        const cityAction = city.status === 'published' ? `<a href="/${city.slug}/">Hap qytetin <b>→</b></a>` : '<em>Guidë në përgatitje</em>';
        marker.bindPopup(`<div class="map-popup"><small>${country.flag} ${country.title}</small><strong>${city.title}</strong><span>Guidë qyteti</span>${cityAction}</div>`);
        marker.addTo(map);
      });
      const homeBounds = shapes.getBounds();
      map.fitBounds(homeBounds, { padding: [25, 25], maxZoom: 4 });
      const ResetControl = L.Control.extend({
        onAdd() {
          const control = L.DomUtil.create('div', 'leaflet-bar leaflet-control atlas-reset-control');
          const button = L.DomUtil.create('a', '', control);
          button.href = '#'; button.title = 'Shiko të gjithë hartën'; button.setAttribute('aria-label', 'Zvogëlo dhe shiko të gjithë hartën'); button.textContent = '⤢';
          L.DomEvent.disableClickPropagation(control);
          L.DomEvent.on(button, 'click', (event:any) => { L.DomEvent.preventDefault(event); map.flyToBounds(homeBounds, { padding: [25, 25], maxZoom: 4, duration: .65 }); });
          return control;
        },
      });
      new ResetControl({ position: 'topleft' }).addTo(map);
    });
  }
  const search=document.querySelector<HTMLInputElement>('#country-search'); const cards=[...document.querySelectorAll<HTMLElement>('[data-destination]')]; const empty=document.querySelector<HTMLElement>('#no-results')!; const result=document.querySelector<HTMLElement>('#catalogue-result'); const letterButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-letter]')]; let activeLetter='';
  function update(){const q=search?.value.trim().toLocaleLowerCase('sq')||'';let visible=0;cards.forEach(card=>{const show=(!q||card.dataset.name?.includes(q))&&(!activeLetter||card.dataset.letter===activeLetter);card.hidden=!show;if(show)visible++});empty.hidden=visible>0;if(result)result.textContent=`${visible} ${visible===1?'shtet':'shtete'}`}
  search?.addEventListener('input',update);letterButtons.forEach(button=>button.addEventListener('click',()=>{activeLetter=button.dataset.letter||'';letterButtons.forEach(item=>item.classList.toggle('is-active',item===button));update()}));

  const comparison=document.querySelector<HTMLElement>('#country-comparison');
  if(comparison){
    type ComparisonCountry={code:string;name:string;flag:string;values?:number[]};
    type WorldBankRow={countryiso3code:string;value:number|null;date:string};
    const data:ComparisonCountry[]=JSON.parse(comparison.dataset.countries||'[]');
    const inputs=[...comparison.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const chart=document.querySelector<SVGSVGElement>('#radar-chart');
    const legend=document.querySelector<HTMLElement>('#chart-legend');
    const count=document.querySelector<HTMLElement>('#selection-count');
    const help=document.querySelector<HTMLElement>('#choice-help');
    const metrics=[
      {code:'SP.DYN.LE00.IN',label:'Jetëgjatësia',inverse:false},
      {code:'NY.GDP.PCAP.PP.CD',label:'Fuqia blerëse',inverse:false},
      {code:'VC.IHR.PSRC.P5',label:'Siguria',inverse:true},
      {code:'SL.UEM.TOTL.ZS',label:'Punësimi',inverse:true},
      {code:'EN.ATM.PM25.MC.M3',label:'Ajri i pastër',inverse:true},
      {code:'IT.NET.USER.ZS',label:'Aksesi digjital',inverse:false},
    ];
    const colors=['#e7c9da','#d8a74b','#77b8b0','#92a7d5','#e58f7c','#b6ce78'];
    const ns='http://www.w3.org/2000/svg',center={x:340,y:280},radius=195;
    const point=(axis:number,value:number)=>{const angle=-Math.PI/2+Math.PI*2*axis/metrics.length;return `${center.x+Math.cos(angle)*radius*value/100},${center.y+Math.sin(angle)*radius*value/100}`};
    const draw=()=>{
      if(!chart||!legend)return;
      const selected=inputs.filter(input=>input.checked).map(input=>data.find(country=>country.code===input.value)!).filter(country=>country?.values);
      inputs.forEach(input=>{input.disabled=!data.find(country=>country.code===input.value)?.values||(!input.checked&&selected.length>=6)});
      if(count)count.textContent=`${selected.length} / 6 zgjedhur`;
      if(help)help.textContent=selected.length>=6?'Ke arritur maksimumin prej 6 shtetesh.':`Mund të zgjedhësh edhe ${6-selected.length} ${6-selected.length===1?'shtet':'shtete'}.`;
      inputs.forEach(input=>{const label=input.closest<HTMLElement>('label');const colorIndex=selected.findIndex(country=>country.code===input.value);label?.classList.toggle('has-chart-color',colorIndex>=0);if(label&&colorIndex>=0)label.style.setProperty('--chart-color',colors[colorIndex]);else label?.style.removeProperty('--chart-color')});
      chart.querySelectorAll('g').forEach(group=>group.remove());
      const grid=document.createElementNS(ns,'g');grid.setAttribute('aria-hidden','true');
      [20,40,60,80,100].forEach(level=>{const shape=document.createElementNS(ns,'polygon');shape.setAttribute('points',metrics.map((_,axis)=>point(axis,level)).join(' '));shape.setAttribute('fill',level===100?'rgba(255,255,255,.018)':'none');shape.setAttribute('stroke','rgba(255,255,255,.12)');grid.append(shape)});
      metrics.forEach((metric,axis)=>{const end=point(axis,100).split(',');const line=document.createElementNS(ns,'line');line.setAttribute('x1',String(center.x));line.setAttribute('y1',String(center.y));line.setAttribute('x2',end[0]);line.setAttribute('y2',end[1]);line.setAttribute('stroke','rgba(255,255,255,.11)');grid.append(line);const position=point(axis,116).split(',');const text=document.createElementNS(ns,'text');text.setAttribute('x',position[0]);text.setAttribute('y',position[1]);text.setAttribute('fill','rgba(255,255,255,.7)');text.setAttribute('font-size','12');text.setAttribute('font-family','Inter,system-ui,sans-serif');text.setAttribute('text-anchor',axis===1||axis===2?'start':axis===4||axis===5?'end':'middle');text.setAttribute('dominant-baseline','middle');text.textContent=metric.label;grid.append(text)});chart.append(grid);
      const plots=document.createElementNS(ns,'g');selected.forEach((country,index)=>{const shape=document.createElementNS(ns,'polygon');shape.setAttribute('points',country.values!.map((value,axis)=>point(axis,value)).join(' '));shape.setAttribute('fill',`${colors[index]}24`);shape.setAttribute('stroke',colors[index]);shape.setAttribute('stroke-width','2.5');shape.setAttribute('stroke-linejoin','round');plots.append(shape);country.values!.forEach((value,axis)=>{const position=point(axis,value).split(',');const dot=document.createElementNS(ns,'circle');dot.setAttribute('cx',position[0]);dot.setAttribute('cy',position[1]);dot.setAttribute('r','3.5');dot.setAttribute('fill',colors[index]);plots.append(dot)})});chart.append(plots);
      legend.replaceChildren(...selected.map((country,index)=>{const item=document.createElement('span');const swatch=document.createElement('i');swatch.style.background=colors[index];item.append(swatch,document.createTextNode(`${country.flag} ${country.name}`));return item}));
    };
    const load=async()=>{
      try{
        inputs.forEach(input=>input.disabled=true);
        const codes=data.map(country=>country.code).join(';');
        const series=await Promise.all(metrics.map(async metric=>{const response=await fetch(`https://api.worldbank.org/v2/country/${codes}/indicator/${metric.code}?format=json&mrnev=1&per_page=100`);if(!response.ok)throw new Error('World Bank API');const payload=await response.json();return (payload?.[1]||[]) as WorldBankRow[]}));
        metrics.forEach((metric,metricIndex)=>{const available=series[metricIndex].filter(row=>typeof row.value==='number');const values=available.map(row=>Number(row.value));const min=Math.min(...values),max=Math.max(...values);data.forEach(country=>{const raw=available.find(row=>row.countryiso3code===country.code)?.value;if(typeof raw!=='number'||!Number.isFinite(min)||max===min)return;(country.values??=Array(metrics.length).fill(NaN))[metricIndex]=Math.round(20+80*(metric.inverse?(max-raw)/(max-min):(raw-min)/(max-min)))})});
        data.forEach(country=>{if(country.values?.some(value=>!Number.isFinite(value)))delete country.values});
        inputs.forEach(input=>{const available=Boolean(data.find(country=>country.code===input.value)?.values);if(!available){input.checked=false;input.closest('label')?.setAttribute('title','Nuk ka ende të dhëna të plota për të gjashtë treguesit')}input.disabled=!available});
        if(!inputs.some(input=>input.checked&&!input.disabled))inputs.filter(input=>!input.disabled).slice(0,3).forEach(input=>input.checked=true);
        inputs.forEach(input=>input.addEventListener('change',()=>{if(inputs.filter(item=>item.checked).length===0){input.checked=true;return}draw()}));draw();
      }catch(error){inputs.forEach(input=>input.disabled=true);if(help)help.textContent='Të dhënat nuk u ngarkuan. Provo sërish pas pak.';if(chart){const message=document.createElementNS(ns,'text');message.setAttribute('x','340');message.setAttribute('y','280');message.setAttribute('text-anchor','middle');message.setAttribute('fill','rgba(255,255,255,.62)');message.textContent='Grafiku përkohësisht i padisponueshëm';chart.append(message)}}
    };
    load();
  }
</script>

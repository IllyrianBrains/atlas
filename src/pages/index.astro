;font-size:11px;font-weight:650;text-overflow:ellipsis;white-space:nowrap}.country-choices i{width:10px;height:10px;border:1px solid rgba(255,255,255,.25);border-radius:50%}.country-choices label.has-chart-color i{border-color:var(--chart-color);background:var(--chart-color);box-shadow:0 0 0 3px color-mix(in srgb,var(--chart-color) 18%,transparent)}.choice-help{margin:15px 0 0;color:rgba(255,255,255,.45);font-size:9px}.chart-panel{display:flex;min-width:0;flex-direction:column;padding:25px 30px 22px}.chart-stage{width:100%;max-width:720px;margin:auto}.chart-stage svg{display:block;width:100%;height:auto;overflow:visible}.chart-legend{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:8px;min-height:43px;padding:8px;border-bottom:1px solid rgba(255,255,255,.1)}.chart-legend span{display:flex;align-items:center;gap:8px;padding:7px 11px;border:1px solid rgba(255,255,255,.13);border-radius:999px;color:#fff;background:rgba(255,255,255,.055);font-size:11px;font-weight:700}.chart-legend i{width:20px;height:4px;border-radius:3px}.index-note{display:grid;grid-template-columns:30px 1fr;gap:13px;align-items:start;margin-top:20px;color:rgba(255,255,255,.42);font-size:10px}.index-note>span{display:grid;width:25px;height:25px;place-items:center;border:1px solid rgba(255,255,255,.22);border-radius:50%;color:#c9aebd;font-family:serif;font-style:italic}.index-note p{max-width:930px;margin:3px 0 0;line-height:1.55}.index-note strong,.index-note a{color:rgba(255,255,255,.76)}

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { publishedDestinations, getParentCountry } from '../data/atlas';
import { atlasCities } from '../data/cities';
import { atlasQuizzes } from '../data/quizzes';

const htmlFiles = import.meta.glob(['../data/atlas/*.html', '../data/cities/*.html'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const contentBySlug: Record<string, string> = {};
for (const [path, content] of Object.entries(htmlFiles)) {
  const slug = path.split('/').pop()!.replace('.html', '');
  contentBySlug[slug] = content;
}

const publishedWithoutContent = publishedDestinations.filter((destination) => !contentBySlug[destination.slug]);
if (publishedWithoutContent.length > 0) {
  throw new Error(`Published Atlas destinations need guide content: ${publishedWithoutContent.map(({ slug }) => slug).join(', ')}`);
}

export function getStaticPaths() {
  return publishedDestinations.map((country) => ({ params: { slug: country.slug }, props: { country } }));
}

const { country } = Astro.props;
const html = contentBySlug[country.slug] ?? '';
const parentCountry = getParentCountry(country);
const cities = atlasCities.filter((city) => city.countrySlug === country.slug);
const publishedCities = cities.filter((city) => city.status === 'published');
const hasQuiz = atlasQuizzes.some((quiz) => quiz.slug === country.slug);
const countryPriorities = country.priorities ?? [];
const countryCodes: Record<string, string> = {
  gjermani:'DEU', zvicer:'CHE', austri:'AUT', france:'FRA', finlande:'FIN', suedi:'SWE', malte:'MLT', itali:'ITA', 'mbreteria-e-bashkuar':'GBR',
};
const countryGeoNames: Record<string, string> = { france:'France', malte:'Malta' };
const countryMap = parentCountry ? null : {
  slug:country.slug, title:country.title, flag:country.flag, iso:countryCodes[country.slug], geoName:countryGeoNames[country.slug],
  fallbackCenter:country.slug === 'malte' ? [35.94,14.38] : undefined,
  cities:cities.map((city) => ({ slug:city.slug, title:city.title, status:city.status, center:[city.lat,city.lng] })),
};
---
<BaseLayout title={`${country.title} · Atlas · Illyrian Brains`} description={`Udhëzuesi Atlas për ${country.title} — informacion praktik për integrim, mbledhur nga komuniteti Illyrian Brains.`} leaflet={!parentCountry}>
  <Header />
  <main>
    <section class="country-hero tone-dark">
      <div class="container city-page country-hero-grid">
        <div>
        <p class="eyebrow">{parentCountry ? <><a href={`/${parentCountry.slug}/`}>{parentCountry.title}</a><span> / </span>Qytet</> : 'Atlas · Shtet'}</p>
        <h1>{country.flag} {country.title}</h1>
        <p class="about-body">Informacion praktik i mbledhur nga komuniteti Illyrian Brains për t’u orientuar në {country.title}{parentCountry ? `, ${parentCountry.title}` : ''}. Nuk zëvendëson burimet zyrtare.</p>
        <div class="country-hero-actions">{html && <a href="#udhezuesi">Lexo udhëzuesin ↓</a>}{hasQuiz && <a href={`/lojera/${country.slug}/`}>Testo njohuritë →</a>}</div>
        </div>
        {countryPriorities.length > 0 && <aside class="priority-card"><p>Fillo këtu</p><h2>3 prioritetet e para</h2><ol>{countryPriorities.map((item) => <li><span>✓</span>{item}</li>)}</ol><small>Kontrollo gjithmonë kërkesat aktuale te burimet zyrtare.</small></aside>}
      </div>
    </section>

    {countryMap && <section class="country-map-section"><div class="country-map-heading"><p class="eyebrow">Harta e rrjetit</p><h2>{country.title} dhe qytetet IB</h2><p>Kufiri i shtetit krijon referencën gjeografike; pikat tregojnë qytetet ku rrjeti Illyrian Brains është i orientuar.</p></div><div class="guide-country-map" id="guide-country-map" data-boundaries="/assets/maps/countries-110m.geojson" data-country={JSON.stringify(countryMap)} aria-label={`Harta interaktive e ${country.title} dhe qyteteve të rrjetit`}></div><div class="country-map-legend"><span><i></i>Kufiri i shtetit</span><span><i></i>Qytet IB</span></div></section>}

    {publishedCities.length > 0 && <section class="city-directory tone-white"><div class="container city-page"><p class="eyebrow">Guidat lokale</p><div class="city-directory-heading"><h2>Zgjidh qytetin</h2><p>Informacion më i detajuar për banesën, transportin dhe shërbimet në qytet.</p></div><div class="city-links">{publishedCities.map((city) => <a href={`/${city.slug}/`}><span><small>Guidë qyteti</small><strong>{city.title}</strong></span><b>→</b></a>)}</div></div></section>}

    {(html || cities.length === 0) && <section class={`section tone-white guide-section ${parentCountry ? 'city-guide' : 'country-story'}`} id="udhezuesi">
      <div class="container guide-layout">
        {html
          ? <div class="atlas-content" set:html={html} />
          : <div class="atlas-content"><h1>Guida po përgatitet</h1><p>Përmbajtja lokale për {country.title} do të shtohet së shpejti nga komuniteti.</p>{parentCountry && <p>Ndërkohë, mund të lexoni <a href={`/${parentCountry.slug}/`}>guidën e {parentCountry.title}</a> për informacionin që vlen në nivel shteti.</p>}</div>}
      </div>
    </section>}
  </main>
  <Footer />
</BaseLayout>


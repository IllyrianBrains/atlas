<script>
  const content=document.querySelector<HTMLElement>('.atlas-content');
  if(content){
    const imageParagraphs=[...content.querySelectorAll<HTMLParagraphElement>('p:has(> img:only-child)')];let run:HTMLParagraphElement[]=[];
    const group=()=>{if(run.length>1){const gallery=document.createElement('div');gallery.className=`atlas-gallery ${run.length===3?'gallery-three':''}`;run[0].before(gallery);run.forEach(p=>gallery.append(p))}run=[]};
    imageParagraphs.forEach((p,index)=>{if(!run.length||run.at(-1)?.nextElementSibling===p)run.push(p);else{group();run.push(p)}if(index===imageParagraphs.length-1)group()});
    content.querySelectorAll('table').forEach(table=>{if(!table.parentElement?.classList.contains('table-scroll')){const wrap=document.createElement('div');wrap.className='table-scroll';table.before(wrap);wrap.append(table)}});
  }

  declare global { interface Window { L:any } }
  const countryMapElement=document.querySelector<HTMLElement>('#guide-country-map');
  if(countryMapElement&&window.L){
    const L=window.L;const country=JSON.parse(countryMapElement.dataset.country||'{}');
    const map=L.map(countryMapElement,{scrollWheelZoom:true,touchZoom:true,zoomControl:true,minZoom:3}).setView(country.fallbackCenter||[48,12],5);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'}).addTo(map);
    fetch(countryMapElement.dataset.boundaries||'').then(response=>response.json()).then(world=>{
      const feature=world.features.find((item:any)=>item.properties.iso_a3===country.iso||item.properties.name===country.geoName);
      let bounds:any;
      if(feature){const shape=L.geoJSON(feature,{style:{color:'#c9aebd',weight:2,opacity:1,fillColor:'#744761',fillOpacity:.38}}).addTo(map);shape.bindTooltip(`${country.flag} ${country.title}`,{sticky:true});bounds=shape.getBounds()}
      country.cities.forEach((city:any)=>{const marker=L.circleMarker(city.center,{radius:7,color:'#fff',weight:2,fillColor:city.status==='published'?'#744761':'#d8a74b',fillOpacity:1}).addTo(map);const action=city.status==='published'?`<a href="/${city.slug}/">Hap guidën →</a>`:'<span>Në përgatitje</span>';marker.bindTooltip(city.title,{direction:'top',offset:[0,-7]});marker.bindPopup(`<div class="map-popup"><small>Qytet IB · ${country.title}</small><strong>${city.title}</strong>${action}</div>`)});
      if(bounds?.isValid())map.fitBounds(bounds,{padding:[34,34],maxZoom:7});else if(country.fallbackCenter)map.setView(country.fallbackCenter,9);
    });
  }
</script>

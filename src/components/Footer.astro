---
// Adapted from illyrianbrains.org's Footer.astro for the atlas.illyrianbrains.org
// subdomain, then rebuilt around Atlas itself (see Header.astro): the brand mark
// and "Eksploro" links stay on Atlas, only "Bashkohu" points off-site to the
// broader community (forum, Discord, joining the main network).
const MAIN_SITE = 'https://illyrianbrains.org';
const isHome = Astro.url.pathname === '/';
---
<footer class="footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" aria-label="Atlas nga Illyrian Brains"><img src="/assets/logo.png" alt="Illyrian Brains network" /></a>
      <p>Rrjeti shqiptar i profesionistëve — për njohje, dije dhe bashkëpunim.</p>
    </div>
    <div class="footer-column">
      <p class="footer-label">Eksploro</p>
      <a href="/" aria-current={isHome ? 'page' : undefined}>Ballina</a>
      <a href="/rreth/">Rreth Atlas</a>
      <a href="/lojera/">Lojëra</a>
    </div>
    <div class="footer-column">
      <p class="footer-label">Bashkohu</p>
      <a href="https://discord.gg/AAZFUTRQZ" target="_blank" rel="noreferrer">Discord ↗</a>
      <a href="https://forum.illyrianbrains.org" target="_blank" rel="noreferrer">Forum ↗</a>
      <a href="mailto:illyrianbrains@gmail.com">Email</a>
      <a class="footer-register" href={`${MAIN_SITE}/anetaresohu/`}>Anëtarësohu →</a>
    </div>
    <div class="footer-column">
      <p class="footer-label">Na ndiqni</p>
      <a href="https://www.linkedin.com/company/illyrian-brains/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a href="https://www.instagram.com/illyrianbrains/" target="_blank" rel="noreferrer">Instagram ↗</a>
      <a href="https://github.com/IllyrianBrains" target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 Illyrian Brains Network</span>
    <span>Lidhim mendjet · Ndërtojmë të ardhmen</span>
    <span>atlas.illyrianbrains.org</span>
  </div>
</footer>
